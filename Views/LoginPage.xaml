<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Store_Credit_Tracker.Views.LoginPage"
             BackgroundColor="#1a1a2e"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid Padding="30" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

        <VerticalStackLayout Grid.Row="0"
                             Spacing="10"
                             Margin="0,50,0,50"
                             HorizontalOptions="Center">

            <Image Source="app_logo.png"
                   WidthRequest="100"
                   HeightRequest="100"
                   HorizontalOptions="Center"/>

            <Label Text="Store Credit Tracker"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#ffffff"
                   HorizontalOptions="Center"/>

            <Label Text="Please login to continue"
                   FontSize="14"
                   TextColor="#888888"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <Entry x:Name="UsernameEntry"
               Grid.Row="1"
               Placeholder="Username"
               PlaceholderColor="#888888"
               BackgroundColor="#2a2a3e"
               TextColor="#ffffff"
               FontSize="16"
               HeightRequest="50"
               Margin="0,0,0,15"/>

        <Entry x:Name="PasswordEntry"
               Grid.Row="2"
               Placeholder="Password"
               PlaceholderColor="#888888"
               BackgroundColor="#2a2a3e"
               TextColor="#ffffff"
               FontSize="16"
               HeightRequest="50"
               IsPassword="True"
               Margin="0,0,0,20"/>

        <Button x:Name="LoginButton"
                Grid.Row="3"
                Text="LOGIN"
                BackgroundColor="#4a90e2"
                TextColor="#ffffff"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnLoginClicked"/>

        <Button Grid.Row="4"
                Text="CREATE ACCOUNT"
                BackgroundColor="#2a2a3e"
                TextColor="#4a90e2"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="40"
                Margin="0,10,0,0"
                Clicked="OnCreateAccountClicked"/>

        <Label x:Name="MessageLabel"
               Grid.Row="5"
               Text=""
               TextColor="#ff4444"
               FontSize="12"
               HorizontalOptions="Center"
               Margin="0,10,0,0"/>
    </Grid>
</ContentPage>