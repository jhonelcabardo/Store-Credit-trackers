<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Store_Credit_Tracker.Views.ReportsPage"
             Title="Reports">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Select Report Period" FontSize="18" FontAttributes="Bold"/>

            <Picker x:Name="PeriodPicker" Title="Select Period">
                <Picker.Items>
                    <x:String>Daily</x:String>
                    <x:String>Weekly</x:String>
                    <x:String>Monthly</x:String>
                </Picker.Items>
            </Picker>

            <Button Text="Generate Report" 
                    BackgroundColor="#4ECDC4"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnGenerateReportClicked"/>

            <Border BackgroundColor="#F5F5F5" Padding="15" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout>
                    <Label Text="Summary" FontSize="16" FontAttributes="Bold"/>
                    <Label x:Name="TotalUtangLabel" Text="Total Utang: ₱0"/>
                    <Label x:Name="TotalPaidLabel" Text="Total Paid: ₱0"/>
                    <Label x:Name="NetBalanceLabel" Text="Net Balance: ₱0"/>
                    <Label x:Name="TransactionCountLabel" Text="Total Transactions: 0"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>