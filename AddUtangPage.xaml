<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Store_Credit_Tracker.Views.AddUtangPage"
    Title="Add Credit">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Customer" FontAttributes="Bold" />
            <Label x:Name="lblCustomerName" Text="No customer selected" />

            <Label Text="Amount" FontAttributes="Bold" />
            <Entry x:Name="txtAmount" Placeholder="Amount" Keyboard="Numeric" />

            <Label Text="Due Date" FontAttributes="Bold" />
            <DatePicker x:Name="dueDatePicker" />

            <Label Text="Notes" FontAttributes="Bold" />
            <Editor x:Name="txtNotes" Placeholder="Notes" HeightRequest="100" />

            <Button Text="Save Credit" Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>